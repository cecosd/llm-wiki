{
  "name": "llm-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Personal knowledge library in the LLM Wiki pattern (Karpathy): raw/ → wiki/, maintained by Claude Code. Interface in English and Bulgarian, more languages via JSON.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "inbox": "node scripts/inbox.js",
    "extract": "node scripts/extract.js",
    "status": "node scripts/status.js",
    "pending": "node scripts/status.js --pending",
    "fix-paths": "node scripts/fix-paths.js",
    "lint": "node scripts/lint.js",
    "lint:quick": "node scripts/lint.js --quick",
    "new": "node scripts/new.js",
    "serve": "node scripts/server.js",
    "launch": "bash scripts/launch/wsl-start.sh",
    "launch:install": "bash scripts/launch/install-windows.sh",
    "remove": "node scripts/remove.js",
    "dupes": "node scripts/merge.js",
    "merge-sources": "node scripts/merge-sources.js",
    "index": "node scripts/index.js",
    "i18n:check": "node scripts/i18n-check.js",
    "content": "node scripts/content.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tailwindcss/browser": "^4.3.3",
    "@tesseract.js-data/bul": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "adm-zip": "^0.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.9.0",
    "marked": "^18.1.2",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "vue": "^3.5.44"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "license": "GPL-3.0-or-later"
}
